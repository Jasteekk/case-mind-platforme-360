<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Case Mind — Case 360</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.263.1/umd/lucide.min.js"></script>
<style>
:root {
  --bg-deep:    #091617;
  --bg-mid:     #0D2728;
  --bg-card:    #0f3133;
  --gold:       #C9A84C;
  --gold-dim:   rgba(201,168,76,0.18);
  --gold-glow:  rgba(201,168,76,0.08);
  --text-main:  #FFFFFF;
  --text-muted: #A8B2B3;
  --text-dim:   #667a7b;
  --red:        #e05252;
  --orange:     #e07f30;
  --green:      #3cb887;
  --blue:       #4a8fe8;
  --border:     rgba(201,168,76,0.2);
  --glass:      rgba(13,39,40,0.7);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg-deep);color:var(--text-main);font-family:'Montserrat',sans-serif;font-size:14px;overflow:hidden}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(201,168,76,0.3);border-radius:3px}

/* ── LAYOUT ────────────────────────────────────────── */
.app{display:flex;height:100vh;width:100vw;overflow:hidden}

/* ── SIDEBAR ──────────────────────────────────────── */
.sidebar{
  width:240px;flex-shrink:0;
  background:var(--bg-mid);
  border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  padding:0;
  position:relative;
  z-index:10;
}
.sidebar::after{
  content:'';position:absolute;top:0;right:-1px;width:1px;height:100%;
  background:linear-gradient(to bottom,transparent,var(--gold),transparent);
  opacity:.4;
}
.sb-logo{
  padding:28px 20px 20px;
  border-bottom:1px solid var(--border);
  cursor:default;
}
.sb-logo .brand{
  font-family:'Cinzel',serif;
  font-size:18px;font-weight:700;
  color:var(--gold);
  letter-spacing:.06em;
  display:flex;align-items:center;gap:10px;
}
.sb-logo .brand svg{color:var(--gold)}
.sb-logo .tagline{
  font-size:9px;font-weight:500;letter-spacing:.18em;
  text-transform:uppercase;color:var(--text-dim);
  margin-top:4px;padding-left:2px;
}

.sb-new-btn{
  margin:16px 16px 12px;
  background:linear-gradient(135deg,#b8912d,var(--gold));
  color:#091617;
  border:none;border-radius:8px;
  padding:11px 14px;
  font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600;
  cursor:pointer;display:flex;align-items:center;gap:8px;
  box-shadow:0 0 18px rgba(201,168,76,0.35),0 2px 8px rgba(0,0,0,0.4);
  transition:all .25s;letter-spacing:.02em;
}
.sb-new-btn:hover{
  box-shadow:0 0 28px rgba(201,168,76,0.55),0 4px 12px rgba(0,0,0,0.4);
  transform:translateY(-1px);
}

.sb-section-label{
  font-size:9px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--text-dim);padding:14px 20px 6px;
}

.sb-nav{flex:1;overflow-y:auto}
.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:10px 20px;
  color:var(--text-muted);font-size:13px;font-weight:400;
  cursor:pointer;transition:all .2s;
  border-left:3px solid transparent;
  margin:1px 0;
  border-radius:0 6px 6px 0;
  margin-right:8px;
}
.nav-item:hover{background:var(--gold-glow);color:var(--text-main)}
.nav-item.active{
  background:var(--gold-dim);color:var(--gold);
  border-left-color:var(--gold);font-weight:500;
}
.nav-item svg{width:15px;height:15px;flex-shrink:0}

.sb-footer{
  padding:16px 20px;
  border-top:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
}
.sb-avatar{
  width:34px;height:34px;border-radius:50%;
  background:linear-gradient(135deg,#1a4a4c,#0f3133);
  border:1.5px solid var(--gold);
  display:flex;align-items:center;justify-content:center;
  font-family:'Cinzel',serif;font-size:13px;font-weight:600;color:var(--gold);
  flex-shrink:0;
}
.sb-user-info .name{font-size:12px;font-weight:500;color:var(--text-main)}
.sb-user-info .role{font-size:10px;color:var(--text-dim);margin-top:1px}

/* ── MAIN ─────────────────────────────────────────── */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;background:var(--bg-deep)}

/* ── TOPBAR ─────────────────────────────────────────── */
.topbar{
  height:60px;flex-shrink:0;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 28px;
  background:rgba(9,22,23,0.95);
  backdrop-filter:blur(12px);
}
.topbar-left .greeting{font-family:'Cinzel',serif;font-size:15px;font-weight:600;color:var(--text-main)}
.topbar-left .sub{font-size:11px;color:var(--text-dim);margin-top:2px}
.topbar-right{display:flex;align-items:center;gap:14px}
.topbar-badge{
  position:relative;cursor:pointer;
  width:34px;height:34px;border-radius:8px;
  background:var(--bg-mid);border:1px solid var(--border);
  display:flex;align-items:center;justify-content:center;
  color:var(--text-muted);transition:all .2s;
}
.topbar-badge:hover{border-color:var(--gold);color:var(--gold)}
.notif-dot{
  position:absolute;top:6px;right:7px;
  width:7px;height:7px;border-radius:50%;
  background:var(--red);border:1.5px solid var(--bg-deep);
}
.topbar-date{font-size:12px;color:var(--text-dim)}

/* ── VIEW CONTAINER ─────────────────────────────── */
.view{display:none;flex:1;overflow-y:auto;padding:24px 28px;animation:fadeIn .3s ease}
.view.active{display:flex;flex-direction:column;gap:20px}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ── CARDS / GLASS ─────────────────────────────────── */
.card{
  background:var(--glass);
  border:1px solid var(--border);
  border-radius:12px;
  backdrop-filter:blur(8px);
  padding:20px;
}
.card-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;
}
.card-title{
  font-family:'Cinzel',serif;font-size:13px;font-weight:600;
  color:var(--gold);letter-spacing:.04em;
  display:flex;align-items:center;gap:8px;
}
.card-title svg{width:14px;height:14px}

/* ── DASHBOARD ─────────────────────────────────────── */
.dash-grid{display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start}

.priority-feed{display:flex;flex-direction:column;gap:10px}
.prio-card{
  background:rgba(13,39,40,0.5);
  border:1px solid rgba(201,168,76,0.15);
  border-radius:10px;padding:14px 16px;
  display:flex;align-items:flex-start;gap:12px;
  cursor:pointer;transition:all .22s;
  position:relative;overflow:hidden;
}
.prio-card::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  border-radius:3px 0 0 3px;
}
.prio-card.urgent::before{background:var(--red)}
.prio-card.medium::before{background:var(--orange)}
.prio-card.normal::before{background:var(--green)}
.prio-card:hover{border-color:rgba(201,168,76,0.35);background:rgba(15,49,51,0.7);transform:translateX(3px)}
.prio-icon{
  width:36px;height:36px;border-radius:8px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:17px;
}
.prio-icon.urgent{background:rgba(224,82,82,0.15)}
.prio-icon.medium{background:rgba(224,127,48,0.15)}
.prio-icon.normal{background:rgba(60,184,135,0.12)}
.prio-body{flex:1}
.prio-tag{font-size:9px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px}
.prio-tag.urgent{color:var(--red)}
.prio-tag.medium{color:var(--orange)}
.prio-tag.normal{color:var(--green)}
.prio-title{font-size:13px;font-weight:500;color:var(--text-main);margin-bottom:4px}
.prio-meta{font-size:11px;color:var(--text-dim)}
.prio-time{
  font-size:10px;font-weight:600;color:var(--red);
  background:rgba(224,82,82,0.1);padding:3px 8px;border-radius:20px;
  white-space:nowrap;flex-shrink:0;align-self:center;
}

/* météo sidebar */
.meteo-wrap{display:flex;flex-direction:column;gap:14px}
.meteo-stat{
  background:rgba(13,39,40,0.5);border:1px solid var(--border);
  border-radius:10px;padding:14px 16px;
}
.meteo-label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-dim);margin-bottom:8px}
.meteo-value{font-family:'Cinzel',serif;font-size:26px;font-weight:600;color:var(--gold);line-height:1}
.meteo-sub{font-size:11px;color:var(--text-muted);margin-top:4px}
.bar-track{height:6px;background:rgba(255,255,255,0.08);border-radius:3px;margin-top:10px;overflow:hidden}
.bar-fill{height:100%;border-radius:3px;transition:width 1s ease}

.mini-chart{display:flex;align-items:flex-end;gap:4px;height:50px;margin-top:10px}
.bar-col{
  flex:1;border-radius:3px 3px 0 0;
  background:linear-gradient(to top,var(--gold),rgba(201,168,76,0.3));
  opacity:.75;transition:opacity .2s;cursor:pointer;
}
.bar-col:hover{opacity:1}

.stat-row{display:flex;gap:10px;margin-top:4px}
.stat-chip{
  flex:1;background:rgba(13,39,40,0.6);
  border:1px solid var(--border);border-radius:8px;
  padding:10px 12px;text-align:center;
}
.stat-chip .val{font-family:'Cinzel',serif;font-size:20px;color:var(--gold)}
.stat-chip .lbl{font-size:9px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.1em;margin-top:2px}

/* ── INGESTION VIEW ─────────────────────────────────── */
.ingest-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}
.dropzone{
  border:2px dashed var(--gold);border-radius:14px;
  padding:48px 32px;text-align:center;
  background:var(--gold-glow);
  cursor:pointer;transition:all .25s;
  position:relative;overflow:hidden;
}
.dropzone::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 50% 50%,rgba(201,168,76,0.06),transparent 70%);
  pointer-events:none;
}
.dropzone:hover,.dropzone.drag-over{
  border-color:#e0c068;background:rgba(201,168,76,0.1);
  box-shadow:0 0 28px rgba(201,168,76,0.2);
}
.drop-icon{font-size:40px;margin-bottom:14px;display:block}
.drop-title{font-family:'Cinzel',serif;font-size:16px;font-weight:600;color:var(--gold);margin-bottom:8px}
.drop-sub{font-size:12px;color:var(--text-muted);line-height:1.6}
.drop-types{
  display:flex;gap:8px;justify-content:center;margin-top:18px;flex-wrap:wrap;
}
.file-tag{
  font-size:10px;font-weight:600;letter-spacing:.08em;padding:4px 10px;
  border-radius:20px;border:1px solid;
}
.file-tag.pdf{color:#e05252;border-color:rgba(224,82,82,0.4);background:rgba(224,82,82,0.08)}
.file-tag.img{color:#4a8fe8;border-color:rgba(74,143,232,0.4);background:rgba(74,143,232,0.08)}
.file-tag.aud{color:#3cb887;border-color:rgba(60,184,135,0.4);background:rgba(60,184,135,0.08)}

.ai-progress-card{display:flex;flex-direction:column;gap:12px}
.ai-header{
  display:flex;align-items:center;gap:10px;
  padding:12px 16px;
  background:rgba(201,168,76,0.07);border:1px solid var(--border);border-radius:10px;
}
.ai-pulse{
  width:10px;height:10px;border-radius:50%;background:var(--gold);flex-shrink:0;
  animation:pulse 1.4s ease-in-out infinite;
}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(201,168,76,.6)}50%{box-shadow:0 0 0 6px rgba(201,168,76,0)}}
.ai-header-text .label{font-size:12px;font-weight:600;color:var(--gold)}
.ai-header-text .status{font-size:10px;color:var(--text-dim)}
.prog-wrap{margin-top:4px}
.prog-label{display:flex;justify-content:space-between;font-size:11px;color:var(--text-muted);margin-bottom:6px}
.prog-track{height:5px;background:rgba(255,255,255,0.07);border-radius:3px;overflow:hidden}
.prog-fill{
  height:100%;
  background:linear-gradient(90deg,#8b6420,var(--gold),#f0d080);
  border-radius:3px;
  animation:progAnim 3s ease forwards;
}
@keyframes progAnim{from{width:40%}to{width:65%}}

.ai-task-list{display:flex;flex-direction:column;gap:8px}
.ai-task{
  display:flex;align-items:center;gap:10px;
  padding:10px 14px;border-radius:8px;
  background:rgba(13,39,40,0.5);border:1px solid rgba(201,168,76,0.1);
  font-size:12px;
}
.ai-task .task-icon{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ai-task.done .task-icon{background:rgba(60,184,135,0.15)}
.ai-task.done .task-icon svg{color:var(--green)}
.ai-task.active .task-icon{background:rgba(201,168,76,0.15)}
.ai-task.active .task-icon svg{color:var(--gold)}
.ai-task.wait .task-icon{background:rgba(255,255,255,0.05)}
.ai-task.wait .task-icon svg{color:var(--text-dim)}
.ai-task.done{color:var(--text-muted)}
.ai-task.active{color:var(--text-main)}
.ai-task.wait{color:var(--text-dim)}
.task-spin{animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

.file-preview{margin-top:8px;display:flex;flex-direction:column;gap:6px}
.file-item{
  display:flex;align-items:center;gap:10px;
  padding:8px 12px;border-radius:8px;
  background:rgba(13,39,40,0.5);border:1px solid rgba(201,168,76,0.12);
  font-size:12px;color:var(--text-muted);
}
.file-item svg{color:var(--gold);width:14px;height:14px;flex-shrink:0}
.file-item .fname{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text-main)}
.file-item .fsize{font-size:10px}

/* ── CASE VIEW ────────────────────────────────────────── */
.case-layout{display:flex;flex-direction:column;gap:20px}
.timeline-wrap{position:relative}
.timeline-track{
  display:flex;align-items:center;
  padding:20px 24px;gap:0;
  background:var(--glass);border:1px solid var(--border);border-radius:12px;
  overflow-x:auto;
  scrollbar-width:thin;
}
.tl-line{flex:1;height:2px;background:rgba(201,168,76,0.2);min-width:32px}
.tl-node{
  display:flex;flex-direction:column;align-items:center;cursor:pointer;
  position:relative;flex-shrink:0;
}
.tl-dot{
  width:14px;height:14px;border-radius:50%;
  border:2px solid;
  background:var(--bg-deep);
  transition:all .2s;position:relative;z-index:1;
}
.tl-node.done .tl-dot{border-color:var(--green);background:var(--green)}
.tl-node.current .tl-dot{border-color:var(--gold);background:var(--gold);box-shadow:0 0 10px rgba(201,168,76,0.6)}
.tl-node.alert .tl-dot{border-color:var(--red);background:var(--red);box-shadow:0 0 12px rgba(224,82,82,0.7);animation:alertPulse 1.5s infinite}
@keyframes alertPulse{0%,100%{box-shadow:0 0 8px rgba(224,82,82,.7)}50%{box-shadow:0 0 16px rgba(224,82,82,1)}}
.tl-node.future .tl-dot{border-color:var(--text-dim);background:transparent}
.tl-label{
  font-size:9px;text-align:center;max-width:80px;
  margin-top:8px;line-height:1.4;font-weight:500;
}
.tl-node.done .tl-label{color:var(--text-muted)}
.tl-node.current .tl-label{color:var(--gold)}
.tl-node.alert .tl-label{color:var(--red);font-weight:600}
.tl-node.future .tl-label{color:var(--text-dim)}
.tl-date{font-size:8px;color:var(--text-dim);margin-top:2px}

.case-body{display:grid;grid-template-columns:280px 1fr;gap:20px;align-items:start}

.flash-ai{display:flex;flex-direction:column;gap:10px}
.flash-section{
  background:rgba(13,39,40,0.5);border:1px solid rgba(201,168,76,0.12);
  border-radius:10px;padding:14px 16px;
}
.flash-section h4{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:flex;align-items:center;gap:6px}
.flash-section h4 svg{width:12px;height:12px}
.fact-item{display:flex;gap:8px;margin-bottom:8px;font-size:12px}
.fact-item:last-child{margin-bottom:0}
.fact-bullet{color:var(--gold);flex-shrink:0;margin-top:1px}
.fact-text{color:var(--text-muted);line-height:1.5}
.fact-text strong{color:var(--text-main)}

.person-row{
  display:flex;align-items:center;gap:8px;margin-bottom:8px;
  padding:8px 10px;border-radius:7px;background:rgba(9,22,23,0.4);
}
.person-row:last-child{margin-bottom:0}
.person-avatar{
  width:28px;height:28px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-family:'Cinzel',serif;font-size:11px;font-weight:600;
}
.person-name{font-size:12px;font-weight:500;color:var(--text-main)}
.person-role{font-size:10px;color:var(--text-dim)}

.doc-flow{display:flex;flex-direction:column;gap:10px}
.doc-card{
  background:rgba(13,39,40,0.45);border:1px solid rgba(201,168,76,0.13);
  border-radius:10px;padding:14px 16px;cursor:pointer;transition:all .2s;
}
.doc-card:hover{border-color:rgba(201,168,76,0.35);background:rgba(15,49,51,0.55)}
.doc-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.doc-num{font-size:10px;letter-spacing:.1em;color:var(--text-dim)}
.doc-badge{font-size:9px;font-weight:600;letter-spacing:.08em;padding:2px 8px;border-radius:20px}
.doc-badge.complet{color:var(--green);background:rgba(60,184,135,0.12);border:1px solid rgba(60,184,135,0.3)}
.doc-badge.alerte{color:var(--red);background:rgba(224,82,82,0.1);border:1px solid rgba(224,82,82,0.3)}
.doc-badge.cours{color:var(--gold);background:var(--gold-dim);border:1px solid rgba(201,168,76,0.3)}
.doc-title{font-size:13px;font-weight:500;color:var(--text-main);margin-bottom:4px}
.doc-sub{font-size:11px;color:var(--text-muted)}

/* ── CONTRADICTION MODAL ─────────────────────────────── */
.modal-overlay{
  position:fixed;inset:0;background:rgba(4,14,15,.8);
  display:flex;align-items:center;justify-content:center;
  z-index:1000;backdrop-filter:blur(6px);
  opacity:0;pointer-events:none;transition:opacity .25s;
}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal{
  width:min(820px,94vw);max-height:88vh;overflow-y:auto;
  background:var(--bg-mid);border:1px solid var(--border);
  border-radius:16px;padding:28px;
  box-shadow:0 24px 80px rgba(0,0,0,.7),0 0 40px rgba(201,168,76,.12);
  transform:scale(.96) translateY(10px);transition:transform .3s;
}
.modal-overlay.open .modal{transform:scale(1) translateY(0)}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.modal-title{font-family:'Cinzel',serif;font-size:16px;font-weight:600;color:var(--red)}
.modal-close{
  width:32px;height:32px;border-radius:8px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  color:var(--text-muted);transition:all .2s;
}
.modal-close:hover{background:rgba(255,255,255,.1);color:var(--text-main)}
.contradiction-alert{
  display:flex;align-items:flex-start;gap:10px;
  padding:12px 16px;border-radius:9px;
  background:rgba(224,82,82,0.1);border:1px solid rgba(224,82,82,0.3);
  margin-bottom:18px;font-size:12px;color:var(--text-main);line-height:1.6;
}
.contradiction-alert svg{color:var(--red);flex-shrink:0;margin-top:1px}
.witness-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.witness-card{
  background:rgba(9,22,23,0.5);border-radius:10px;
  border:1px solid rgba(201,168,76,0.12);padding:16px;
}
.witness-name{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;font-weight:600}
.witness-text{font-size:12px;color:var(--text-muted);line-height:1.7}
.witness-text mark{
  background:rgba(224,82,82,0.22);color:var(--red);
  border-bottom:1px solid rgba(224,82,82,0.5);padding:0 2px;border-radius:2px;
}
.ai-verdict{
