  display:flex;align-items:center;justify-content:center;
  border:1.5px solid var(--bg-mid);
}

/* ── OVERLAY (sidebar backdrop on mobile) ── */
.sidebar-overlay{
  display:none;position:fixed;inset:0;
  background:rgba(4,14,15,0.7);backdrop-filter:blur(4px);
  z-index:149;
}
.sidebar-overlay.open{display:block}

/* ══════════════════════════════
   TABLET: 601px – 900px
══════════════════════════════ */
@media(max-width:900px){
  html,body{overflow:hidden}

  /* Sidebar slides in/out */
  .sidebar{
    position:fixed;left:-260px;top:0;bottom:0;
    width:240px;z-index:150;
    transition:left .3s cubic-bezier(.4,0,.2,1);
    box-shadow:4px 0 32px rgba(0,0,0,.5);
  }
  .sidebar.open{left:0}

  /* Show hamburger */
  .mob-menu-btn{display:flex}

  /* Topbar adjustments */
  .topbar{padding:0 16px}
  .topbar-date{display:none}
  .topbar-left .greeting{font-size:13px}
  .topbar-left .sub{font-size:10px;display:none}

  /* Main takes full width */
  .main{width:100vw}

  /* Dashboard: single column */
  .dash-grid{grid-template-columns:1fr}
  .meteo-wrap{display:grid;grid-template-columns:1fr 1fr;gap:12px}

  /* Case: single column */
  .case-body{grid-template-columns:1fr}
  .flash-ai{display:grid;grid-template-columns:1fr 1fr;gap:12px}

  /* Ingest: single column */
  .ingest-layout{grid-template-columns:1fr}

  /* View padding */
  .view{padding:16px}

  /* Chat: contacts hidden by default, shown via toggle */
  #view-chat{left:0;top:60px}
  .cc{
    position:fixed;left:-260px;top:60px;bottom:0;
    width:250px;z-index:100;
    transition:left .3s cubic-bezier(.4,0,.2,1);
    box-shadow:4px 0 24px rgba(0,0,0,.5);
  }
  .cc.open{left:0}
  .cw{width:100%}

  /* Chat back button visible */
  .chat-back-btn{display:flex!important}
}

/* ══════════════════════════════
   MOBILE: ≤600px
══════════════════════════════ */
@media(max-width:600px){
  html,body{overflow:hidden}

  /* Hide desktop sidebar entirely, use bottom nav */
  .sidebar{display:none!important}
  .mob-nav{display:flex}

  /* Main fills screen, bottom nav takes 62px */
  .main{width:100vw}
  .view{padding:12px 12px 74px}

  /* Topbar */
  .topbar{padding:0 12px;height:54px}
  .topbar-left .greeting{font-size:13px}
  .topbar-left .sub{display:none}
  .topbar-date,.topbar-badge:last-child,.topbar-badge:nth-last-child(2){display:none}

  /* Dashboard */
  .dash-grid{grid-template-columns:1fr;gap:12px}
  .meteo-wrap{display:none} /* hide stats sidebar on tiny screen */
  .prio-card{padding:11px 12px;gap:8px}
  .prio-icon{width:30px;height:30px;font-size:14px}
  .prio-meta{display:none}
  .prio-time{font-size:9px}

  /* Case */
  .case-body{grid-template-columns:1fr;gap:12px}
  .flash-ai{display:flex;flex-direction:column;gap:10px}
  .timeline-track{padding:14px 12px;gap:0}

  /* Ingest */
  .ingest-layout{grid-template-columns:1fr}
  .dropzone{padding:28px 16px}
  .witness-grid{grid-template-columns:1fr;gap:10px}

  /* Chat — full screen, contacts as slide-in panel */
  #view-chat{left:0;top:54px;bottom:62px}
  .cc{
    position:fixed;left:-100vw;top:54px;bottom:62px;
    width:100vw;z-index:100;
    transition:left .28s cubic-bezier(.4,0,.2,1);
    box-shadow:none;
  }
  .cc.open{left:0}
  .cw{width:100%}
  .msgs{padding:14px 12px}
  .cia{padding:10px 12px 14px}
  .chat-back-btn{display:flex!important}

  /* Bigger touch targets */
  .nav-item{padding:12px 16px;min-height:44px}
  .ci{padding:13px 14px;min-height:54px}
}

