  gap:4px;cursor:pointer;color:var(--text-dim);font-size:9px;font-weight:500;
  letter-spacing:.06em;text-transform:uppercase;transition:all .2s;
  border-top:2px solid transparent;position:relative;
}
.mob-nav-item svg{width:18px;height:18px;flex-shrink:0}
.mob-nav-item.active{color:var(--gold);border-top-color:var(--gold)}
.mob-nav-badge{
