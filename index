  msgs.appendChild(d);
  ta.value='';ta.style.height='auto';
  msgs.scrollTop=msgs.scrollHeight;
  // auto-reply
  var ac=document.querySelector('.ci.ci-active');
  var init=ac?ac.dataset.init:'ML';
  var cd=contacts[init]||contacts.ML;
  var replies=['Bien reçu, Monsieur le Président. Nous nous conformerons à vos instructions.','Merci pour votre réponse rapide. Nous préparons les documents requis.','Compris. Nous serons présents à l\'audience. Merci de votre diligence.','Je vous remercie. Nous transmettons les éléments au greffe sans délai.'];
  setTimeout(function(){
    var r=replies[Math.floor(Math.random()*replies.length)];
    var rd=document.createElement('div');
    rd.style.cssText='display:flex;align-items:flex-end;gap:10px;align-self:flex-start;max-width:62%';
    rd.innerHTML='<div style="width:32px;height:32px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:Cinzel,serif;font-size:11px;font-weight:600;background:'+cd.bg+';color:'+cd.col+';border:1.5px solid '+cd.border+'">'+init+'</div>'
      +'<div style="display:flex;flex-direction:column;gap:3px">'
      +'<div style="font-size:10px;color:#667a7b;padding:0 4px">'+cd.name+'</div>'
      +'<div style="padding:12px 16px;font-size:13px;line-height:1.65;color:#fff;background:rgba(13,45,47,0.9);border:1px solid rgba(201,168,76,0.13);border-radius:4px 16px 16px 16px;word-break:break-word">'+r+'</div>'
      +'<div style="font-size:10px;color:#667a7b;padding:0 4px">'+t+'</div></div>';
    msgs.appendChild(rd);
    msgs.scrollTop=msgs.scrollHeight;
  },1800);
}
